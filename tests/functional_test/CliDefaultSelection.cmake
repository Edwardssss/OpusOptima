set(output "${BINARY_DIR}/cli-default-selection.solution")
set(explicit_output "${BINARY_DIR}/cli-explicit-assembly.solution")
set(puzzle "${SOURCE_DIR}/asset/puzzle/campaign/ch1-and-prologue/P011.puzzle")
file(REMOVE "${output}" "${explicit_output}")
function(run_cli expected_solver expected_success)
    execute_process(COMMAND "${CLI}" -p "${puzzle}" -o "${output}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 25)
    set(text "${stdout}\n${stderr}")
    if(NOT text MATCHES "Using solver: ${expected_solver}")
        message(FATAL_ERROR "Wrong backend: ${text}")
    endif()
    if(expected_success AND NOT result EQUAL 0)
        message(FATAL_ERROR "CLI failed: ${text}")
    elseif(NOT expected_success AND result EQUAL 0)
        message(FATAL_ERROR "Unsupported explicit backend unexpectedly succeeded: ${text}")
    endif()
endfunction()
run_cli(AssemblySolver TRUE)
file(SHA256 "${output}" default_hash)
file(RENAME "${output}" "${explicit_output}")
run_cli(AssemblySolver TRUE -s assembly)
file(SHA256 "${output}" explicit_hash)
if(NOT default_hash STREQUAL explicit_hash)
    message(FATAL_ERROR "Omitted solver differs from explicit assembly")
endif()
# Unsupported experimental candidates must never replace a previously accepted output.
foreach(pair IN ITEMS "single-atom|SingleAtomSolver" "diatomic|DiatomicSolver"
        "greedy|GreedyPlannerSolver" "default|GreedyPlannerSolver" "milp|RecipeMilp" "mip|RecipeMilp")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 alias)
    list(GET fields 1 identity)
    run_cli("${identity}" FALSE -s "${alias}")
    file(SHA256 "${output}" after)
    if(NOT after STREQUAL explicit_hash)
        message(FATAL_ERROR "Explicit ${alias} changed protected output")
    endif()
endforeach()
foreach(option IN ITEMS unknown help list)
    if(option STREQUAL "unknown")
        set(args -s unknown-solver)
    elseif(option STREQUAL "help")
        set(args --help)
    else()
        set(args --list-solvers)
    endif()
    execute_process(COMMAND "${CLI}" -p "${puzzle}" -o "${output}" ${args}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 25)
    if(option STREQUAL "unknown")
        if(result EQUAL 0)
            message(FATAL_ERROR "Unknown backend succeeded")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${option} failed: ${stdout}\n${stderr}")
    endif()
    if(option STREQUAL "help" AND NOT "${stdout}\n${stderr}" MATCHES "default: assembly")
        message(FATAL_ERROR "Help omitted assembly default")
    endif()
    file(SHA256 "${output}" after)
    if(NOT after STREQUAL explicit_hash)
        message(FATAL_ERROR "${option} changed protected output")
    endif()
endforeach()
file(GLOB leftovers "${output}.candidate-*" "${explicit_output}.candidate-*")
if(leftovers)
    message(FATAL_ERROR "Candidate files leaked: ${leftovers}")
endif()
file(REMOVE "${output}" "${explicit_output}")
