if(NOT DEFINED PUZZLE)
    set(PUZZLE "${SOURCE_DIR}/asset/puzzle/easy/just-salt.puzzle")
endif()
set(solver_args)
if(DEFINED SOLVER)
    list(APPEND solver_args -s "${SOLVER}")
endif()
if(NOT DEFINED OUTPUT_NAME)
    set(OUTPUT_NAME "cli-acceptance.solution")
endif()
set(output "${BINARY_DIR}/${OUTPUT_NAME}")
file(REMOVE "${output}")
execute_process(COMMAND "${CLI}" -p "${PUZZLE}" ${solver_args} -o "${output}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 20)
if(NOT EXISTS "${output}")
    message(FATAL_ERROR "Automatic solution file missing (process=${result}): ${stdout}\n${stderr}")
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Automatic solution exists but process did not finish successfully (process=${result}): ${stdout}\n${stderr}")
endif()
file(READ "${output}.objectives.json" objectives)
foreach(objective cost cycles area)
    string(JSON relative GET "${objectives}" slots ${objective} file)
    string(JSON expected GET "${objectives}" slots ${objective} sha256)
    set(candidate "${BINARY_DIR}/${relative}")
    file(SHA256 "${candidate}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Objective hash differs: ${objective}")
    endif()
    execute_process(COMMAND "${CLI}" verify --puzzle "${PUZZLE}" --solution "${candidate}" --authority legacy-gate --json
        RESULT_VARIABLE verified OUTPUT_VARIABLE measured ERROR_VARIABLE verify_error TIMEOUT 20)
    if(NOT verified EQUAL 0)
        message(FATAL_ERROR "Objective gate failed: ${objective}: ${measured} ${verify_error}")
    endif()
    foreach(metric cost cycles area)
        string(JSON archived GET "${objectives}" slots ${objective} verification metrics ${metric})
        string(JSON observed GET "${measured}" metrics ${metric})
        if(NOT archived EQUAL observed)
            message(FATAL_ERROR "Objective ${objective} ${metric} mismatches same-gate measurement")
        endif()
    endforeach()
endforeach()
file(SHA256 "${output}.objectives.json" manifest_before)
file(SHA256 "${output}" before)
execute_process(COMMAND "${CLI}" -p "${SOURCE_DIR}/asset/puzzle/easy/just-salt.puzzle" -s milp -o "${output}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 20)
if(result EQUAL 0)
    message(FATAL_ERROR "Invalid candidate returned success: ${stdout}\n${stderr}")
endif()
file(SHA256 "${output}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Rejected candidate overwrote existing output")
endif()
if(DEFINED SOLVER AND (SOLVER STREQUAL "diatomic" OR SOLVER STREQUAL "assembly"))
    set(unsupported_puzzle "${SOURCE_DIR}/asset/puzzle/easy/just-salt.puzzle")
    if(SOLVER STREQUAL "assembly")
        set(unsupported_puzzle "${BINARY_DIR}/${OUTPUT_NAME}.malformed.puzzle")
        file(WRITE "${unsupported_puzzle}" "truncated production puzzle")
    endif()
    execute_process(COMMAND "${CLI}" -p "${unsupported_puzzle}"
        -s "${SOLVER}" -o "${output}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 20)
    if(SOLVER STREQUAL "assembly")
        file(REMOVE "${unsupported_puzzle}")
    endif()
    if(result EQUAL 0)
        message(FATAL_ERROR "Unsupported ${SOLVER} puzzle returned success: ${stdout}\n${stderr}")
    endif()
    file(SHA256 "${output}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Unsupported puzzle overwrote existing output")
    endif()
endif()
file(GLOB leftovers "${output}.candidate-*")
if(leftovers)
    message(FATAL_ERROR "Temporary candidates leaked: ${leftovers}")
endif()
file(SHA256 "${output}.objectives.json" manifest_after)
if(NOT manifest_before STREQUAL manifest_after)
    message(FATAL_ERROR "Failed solve overwrote objective manifest")
endif()
file(GLOB bundles "${output}.bundle-*")
file(REMOVE_RECURSE ${bundles})
file(REMOVE "${output}.objectives.json")
file(REMOVE "${output}")
