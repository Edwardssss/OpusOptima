# ─────────────────────────────────────────────────────────────────────────────
# OpusOptima .gitignore
#
# Layout convention: everything generated by a build, a solver run or a
# measurement lives OUTSIDE this repository, under ../artifacts/, and is exposed
# through a symlink so relative paths keep working:
#
#   build  -> ../artifacts/build     compiled trees
#   log    -> ../artifacts/log       runtime logs
#   result -> ../artifacts/result    solver runs, reports, probes, benchmarks
#
# Only source, tests, assets and tools are tracked. Keep this file in sync
# with the repository layout in README.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Artifact roots (symlinks to ../artifacts, plus non-linked fallbacks) ──────
/build
/log
/result
build/
log/
result/
artifacts/
cmake-build-*/
dist/

# ── Compiled objects and binaries ─────────────────────────────────────────────
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.gch
*.pch

# ── CMake / Ninja / toolchain state ──────────────────────────────────────────
CMakeCache.txt
CMakeUserPresets.json
CMakePresets.json
cmake_install.cmake
CTestTestfile.cmake
DartConfiguration.tcl
compile_commands.json
.cache/
.ninja_deps
.ninja_log
build.ninja
*.dep

# ── Test, coverage and benchmark output ──────────────────────────────────────
Testing/
test-artifacts/
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
*.solution
*.solution.objectives.json
*.bundle-*/
assembly-verifier-*/

# ── Python tool state ────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/

# ── Logs and scratch files ───────────────────────────────────────────────────
*.log
*.tmp
*.bak
scratch/
tmp/

# ── IDE and editor state ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db

# ── Third-party build outputs (submodules are tracked as submodules) ─────────
third_party/benchmark/build/
third_party/HiGHS/build/
third_party/spdlog/build/
third_party/googletest/build/
