CompileFlags:
  CompilationDatabase: "build"
  Add:
    - "-std=c++20"
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"

Index:
  Background: Build

Diagnostics:
  ClangTidy:
    Add:
      - "bugprone*"
      - "performance*"
      - "readability*"
      - "modernize*"
    Remove:
      - "modernize-use-trailing-return-type"
      - "readability-braces-around-statements"

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
